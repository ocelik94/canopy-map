# Image version from ghcr.io/ocelik94/canopy-map (a release such as 1.2.0, or latest).
CANOPY_VERSION=latest

# Canopy configuration. Copy to .env and edit. Never commit .env.

# Hostname Caddy serves (clients must use exactly this name).
CANOPY_HOST=canopy-map.local
# TLS mode, switched purely from here (must not be empty):
#   internal          Caddy's local CA, for LAN names like canopy-map.local (default; devices must trust the CA)
#   you@example.com   public domain: Let's Encrypt, this address is the ACME contact
# (CANOPY_HOST must then be a real DNS name pointing at this machine, ports 80/443 reachable from the internet.)
CADDY_TLS=internal

# First-run admin (created only when the database has no users). No default password:
# choose a strong one, then you may remove these two lines after first start.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Login rate limit
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Paths inside the container (volumes are mounted here) - normally leave as is.
DATABASE_PATH=/data/canopy.db
PHOTOS_DIR=/data/photos

# Language of the initial device types/statuses created on first start (en or de). The UI is English
# unless a user picks another language (menu ⋮ → Language).
SEED_LANGUAGE=en
