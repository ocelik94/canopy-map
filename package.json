{
	"name": "canopy-map",
	"private": true,
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24",
		"pnpm": ">=12"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.ts",
		"create-admin": "node scripts/create-admin.ts",
		"licenses:check": "node scripts/licenses.mjs --check",
		"licenses:generate": "node scripts/licenses.mjs --write",
		"seed:demo": "node scripts/seed-demo.ts",
		"seed:hessen": "node scripts/seed-hessen.ts",
		"translate:reference-data": "node scripts/translate-reference-data.ts"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.2.2",
		"better-sqlite3": "^13.0.3",
		"dexie": "^4.4.6",
		"drizzle-orm": "^0.45.4",
		"maplibre-gl": "^6.13.0",
		"pmtiles": "^4.5.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.19.1",
		"drizzle-kit": "^0.31.11",
		"fake-indexeddb": "^6.2.5",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.10.1"
}
